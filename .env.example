# --- LLM / model providers ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=
VOYAGE_API_KEY=

# --- Local dev (no Docker) ---
PIPELINE_MODE=local
STORAGE_BACKEND=local
LOCAL_DATA_DIR=./data
DATABASE_URL=sqlite+aiosqlite:///./data/lecture_copilot.db
CELERY_EAGER=true
WHISPER_MODEL=base

# --- Docker mode (uncomment when using docker compose) ---
# PIPELINE_MODE=docker
# STORAGE_BACKEND=s3
# DATABASE_URL=postgresql+asyncpg://lecture_copilot:change_me@postgres:5432/lecture_copilot
# REDIS_URL=redis://redis:6379/0
# S3_ENDPOINT_URL=http://minio:9000
# CELERY_EAGER=false

# --- Redis (only needed when CELERY_EAGER=false) ---
REDIS_URL=redis://localhost:6379/0

# --- S3 / MinIO (only needed when STORAGE_BACKEND=s3) ---
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=lecture-videos

# --- Auth ---
AUTH_SECRET=change_me_to_a_random_string

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
